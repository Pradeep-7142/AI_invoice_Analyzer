# Copy this file to .env and adjust values before running `docker compose up --build`.
# Never commit a real .env file.

# --- Database ---
DATABASE_NAME=invoiceiq
DATABASE_USERNAME=invoiceiq
DATABASE_PASSWORD=invoiceiq
DATABASE_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-in-real-environments
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
MAX_FILE_SIZE=10MB
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI provider ---
# "mock" runs a fully local, deterministic extraction/classification engine
# so the whole pipeline works with zero external cost or API key.
# Set to "openai" (or another supported provider) and supply AI_API_KEY to
# use a real LLM for OCR-text-to-structured-invoice extraction.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# --- Storage ---
STORAGE_PATH=/data/storage

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
